@model BookMovieTickets.ViewModel.NewPasswordVM

@{
    Layout = "~/Areas/Identity/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<div class="d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow-lg p-4 auth-card">

        <h3 class="text-center mb-4 login-title">🔑 Reset Password</h3>

        <form asp-area="Identity"
              asp-controller="Account"
              asp-action="NewPassword"
              method="post">

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password"></label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           id="newPasswordInput" />

                    <span class="input-group-text"
                          style="cursor:pointer;"
                          onclick="togglePassword('newPasswordInput', this)">
                        <i class="bi bi-eye"></i>
                    </span>
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
                <label asp-for="ConfirmPassword"></label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock-fill"></i>
                    </span>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           id="confirmPasswordInput" />

                    <span class="input-group-text"
                          style="cursor:pointer;"
                          onclick="togglePassword('confirmPasswordInput', this)">
                        <i class="bi bi-eye"></i>
                    </span>
                </div>

                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Button -->
            <button type="submit" class="btn btn-primary w-100">
                Reset Password
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, iconElement) {
            const input = document.getElementById(inputId);
            const icon = iconElement.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}