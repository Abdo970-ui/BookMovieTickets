@model BookMovieTickets.ViewModel.ForgetPasswordVM

@{
    Layout = "~/Areas/Identity/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forget Password";
}

<div class="d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow-lg p-4 auth-card">

        <h3 class="text-center mb-4 login-title">
            🔑 Forgot Password
        </h3>

        <p class="text-center text-muted small mb-3">
            Enter your email or username to reset your password
        </p>

        <form asp-area="Identity"
              asp-controller="Account"
              asp-action="ForgetPassword"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <!-- Email or Username -->
            <div class="mb-3">
                <label asp-for="UserNameOrEmail"></label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-person-lock"></i>
                    </span>

                    <input asp-for="UserNameOrEmail"
                           class="form-control"
                           placeholder="Enter email or username" />
                </div>

                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                Send Reset Link
            </button>

        </form>

        <div class="text-center mt-3">
            <a asp-area="Identity"
                   asp-controller="Account"
                   asp-action="Login"
                   class="text-decoration-none">
                Back to Login
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}