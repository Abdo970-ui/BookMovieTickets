<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>@ViewData["Title"] - Admin</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet">

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- SB Admin -->
    <link href="~/css/admin/sb-admin-2.min.css" rel="stylesheet" />

    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <!-- GLOBAL FIX -->
    <style>

            html, body {
                height: 100%;
                background: #f4f6fb !important;
            }

            #wrapper {
                min-height: 100vh;
                background: #f4f6fb !important;
            }

            #content-wrapper {
                background: transparent !important;
            }

            #content {
                background: transparent !important;
            }

            .container-fluid {
                padding-top: 15px;
                padding-bottom: 20px;
            }

            /* Sidebar improvement */
            .sidebar .nav-item .nav-link {
                border-radius: 8px;
                margin: 3px 10px;
                transition: 0.2s;
            }

                .sidebar .nav-item .nav-link:hover {
                    background: rgba(255,255,255,0.15);
                }

            /* Topbar */
            .topbar {
                background: #ffffff !important;
                border-bottom: 1px solid #e9ecef;
            }

            /* Footer */
            .sticky-footer {
                background: #fff;
                border-top: 1px solid #eee;
            }

    </style>

</head>

<body id="page-top">

    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion">

            <a class="sidebar-brand d-flex align-items-center justify-content-center"
                   href="/Admin/Movies/Index">

                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-film"></i>
                </div>

                <div class="sidebar-brand-text mx-3">
                    Movie Admin
                </div>

            </a>

            <hr class="sidebar-divider my-0">

            <!-- Dashboard -->
            <li class="nav-item active">
                <a class="nav-link" href="/Admin/Movies/Index">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <!-- Users -->
            <li class="nav-item">
                <a class="nav-link" href="/Admin/User/Index">
                    <i class="fas fa-users"></i>
                    <span>Users</span>
                </a>
            </li>

            <hr class="sidebar-divider">

            <div class="sidebar-heading">Pages</div>

            <li class="nav-item">
                <a class="nav-link" href="/Customer/Home/Index">
                    <i class="fas fa-user"></i>
                    <span>Customer Page</span>
                </a>
            </li>

            <hr class="sidebar-divider">

            <div class="sidebar-heading">Account</div>

            <li class="nav-item">
                <a class="nav-link" href="/Identity/Account/Login">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>Login</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/Identity/Account/Register">
                    <i class="fas fa-user-plus"></i>
                    <span>Register</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/Identity/Account/ForgetPassword">
                    <i class="fas fa-key"></i>
                    <span>Forget Password</span>
                </a>
            </li>

        </ul>

        <!-- Content -->
        <div id="content-wrapper" class="d-flex flex-column">

            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar shadow-sm">

                    <span class="ml-3 font-weight-bold text-primary">
                        Admin Panel
                    </span>

                </nav>

                <!-- Main Content -->
                <div class="container-fluid">
                    @RenderBody()
                </div>

            </div>

            <!-- Footer -->
            <footer class="sticky-footer">
                <div class="container my-auto">
                    <div class="text-center text-muted">
                        <span>Copyright &copy; Movie App 2026</span>
                    </div>
                </div>
            </footer>

        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin/sb-admin-2.min.js"></script>

    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
        "positionClass": "toast-top-right",
        "timeOut": "3000",
        "closeButton": true,
        "progressBar": true
        };
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success('@TempData["Success"]');
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            toastr.error('@TempData["Error"]');
        </script>
    }

    @RenderSection("Scripts", required: false)

</body>

</html>