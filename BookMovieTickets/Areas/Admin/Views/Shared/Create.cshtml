@model BookMovieTickets.ViewModels.MovieVM

@{
    ViewData["Title"] = "Add Movie";
}

<h2 class="mb-4">Add Movie</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <!-- Name -->
    <div class="form-group mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- Description -->
    <div class="form-group mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <!-- Main Image -->
    <div class="form-group mb-3">
        <label>Main Image</label>
        <input type="file" asp-for="MainImg" class="form-control" />
        <span asp-validation-for="MainImg" class="text-danger"></span>
    </div>

    <!-- Sub Images -->
    <div class="form-group mb-3">
        <label>Sub Images</label>
        <input type="file" asp-for="SubImages" multiple class="form-control" />
    </div>

    <!-- Price -->
    <div class="form-group mb-3">
        <label>Price</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <!-- Status -->
    <div class="form-group mb-3">
        <label>Available</label>
        <input asp-for="Status" type="checkbox" />
    </div>

    <!-- Date -->
    <div class="form-group mb-3">
        <label>Date</label>
        <input asp-for="DateTime" type="datetime-local" class="form-control" />
    </div>

    <!-- Category -->
    <div class="form-group mb-3">
        <label>Category</label>
        <select asp-for="CategoryId" class="form-control"
                asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
            <option value="">-- Select Category --</option>
        </select>
    </div>

    <!-- Cinema -->
    <div class="form-group mb-3">
        <label>Cinema</label>
        <select asp-for="CinemaId" class="form-control"
                asp-items="@(new SelectList(Model.Cinemas, "Id", "Name"))">
            <option value="">-- Select Cinema --</option>
        </select>
    </div>

    <!-- Actors -->
    <div class="form-group mb-3">
        <label>Actors</label><br />

        @foreach (var actor in Model.Actors)
        {
            <input type="checkbox" name="ActorIds" value="@actor.Id" />
            <label>@actor.Name</label>
            <br />
        }
    </div>

    <!-- Submit -->
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}