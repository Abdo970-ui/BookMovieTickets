@model BookMovieTickets.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h2 class="text-danger mb-4">Delete Movie</h2>

<div class="card p-3">

    <h4>Are you sure you want to delete this movie?</h4>

    <hr />

    <!-- Movie Info -->
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Price:</strong> @Model.Price</p>
    <p><strong>Date:</strong> @Model.DateTime</p>

    <!-- Image -->
    <div class="mb-3">
        <img src="~/images/@Model.MainImg" width="150" />
    </div>

    <!-- Actions -->
    <form asp-area="Admin"
          asp-controller="Movies"
          asp-action="Delete"
          method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>