@model BookMovieTickets.ViewModels.MovieVM

@{
    ViewData["Title"] = "Update Movie";
}

<h2 class="mb-4">Update Movie</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-area="Admin"
      asp-controller="Movies"
      asp-action="Update"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <!-- Name -->
    <div class="form-group mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- Description -->
    <div class="form-group mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- Price -->
    <div class="form-group mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <!-- Status -->
    <div class="form-group mb-3">
        <label class="form-check">
            <input asp-for="Status" type="checkbox" class="form-check-input" />
            Available
        </label>
    </div>

    <!-- Date -->
    <div class="form-group mb-3">
        <label asp-for="DateTime"></label>
        <input asp-for="DateTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="DateTime" class="text-danger"></span>
    </div>

    <!-- Category -->
    <div class="form-group mb-3">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" class="form-control">
            <option value="">-- Select Category --</option>
            @foreach (var item in Model.Categories)
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }
        </select>
    </div>

    <!-- Cinema -->
    <div class="form-group mb-3">
        <label asp-for="CinemaId"></label>
        <select asp-for="CinemaId" class="form-control">
            <option value="">-- Select Cinema --</option>
            @foreach (var item in Model.Cinemas)
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }
        </select>
    </div>

    <!-- Actors -->
    <div class="form-group mb-3">
        <label>Actors</label>

        @foreach (var actor in Model.Actors)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="ActorIds"
                       value="@actor.Id"
                @(Model.ActorIds != null && Model.ActorIds.Contains(actor.Id) ? "checked" : "") />

                <label class="form-check-label">
                    @actor.Name
                </label>
            </div>
        }
    </div>

    <!-- Buttons -->
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}