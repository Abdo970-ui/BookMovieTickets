@model BookMovieTickets.ViewModel.AdminDashboardVM

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

    body {
    background: #0f172a;
    }

    .dashboard-title {
    color: white;
    font-weight: bold;
    }

    .dashboard-subtitle {
    color: #94a3b8;
    }

    .dashboard-card {

    border-radius: 22px;
    padding: 28px;
    color: white;

    display: flex;
    justify-content: space-between;
    align-items: center;

    box-shadow: 0 10px 25px rgba(0,0,0,0.25);

    transition: .3s ease;

    min-height: 160px;
    }

    .dashboard-card:hover {

    transform: translateY(-6px) scale(1.02);

    }

    .users-card {

    background: linear-gradient(135deg,#4f46e5,#7c3aed);

    }

    .movies-card {

    background: linear-gradient(135deg,#dc2626,#ea580c);

    }

    .bookings-card {

    background: linear-gradient(135deg,#0891b2,#06b6d4);

    }

    .revenue-card {

    background: linear-gradient(135deg,#16a34a,#22c55e);

    }

    .card-title {

    font-size: 15px;
    opacity: .9;
    margin-bottom: 10px;
    }

    .dashboard-card h2 {

    font-size: 36px;
    font-weight: bold;
    margin: 0;
    }

    .card-icon {

    font-size: 55px;
    opacity: .25;
    }

    .dashboard-box {

    background: #111827;
    border-radius: 22px;
    padding: 30px;

    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    }

    .dashboard-box h4 {

    color: white;
    font-weight: bold;
    margin-bottom: 25px;
    }

    .most-movie {

    font-size: 32px;
    color: #facc15;
    font-weight: bold;
    }

</style>

<div class="container-fluid py-4">

    <!-- Title -->
    <div class="d-flex justify-content-center align-items-center flex-column mb-4"
         style="min-height: 120px;">

        <h2 class="dashboard-title m-0">
            Admin Dashboard
        </h2>

        <p class="dashboard-subtitle m-0 mt-2">
            Welcome back 👋
        </p>

    </div>

    <!-- Statistics Cards -->
    <div class="row g-4">

        <!-- Users -->
        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card users-card">

                <div>

                    <p class="card-title">
                        Total Users
                    </p>

                    <h2>
                        @Model.TotalUsers
                    </h2>

                </div>

                <div class="card-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

            </div>

        </div>

        <!-- Movies -->
        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card movies-card">

                <div>

                    <p class="card-title">
                        Total Movies
                    </p>

                    <h2>
                        @Model.TotalMovies
                    </h2>

                </div>

                <div class="card-icon">
                    <i class="bi bi-film"></i>
                </div>

            </div>

        </div>

        <!-- Bookings -->
        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card bookings-card">

                <div>

                    <p class="card-title">
                        Total Bookings
                    </p>

                    <h2>
                        @Model.TotalBookings
                    </h2>

                </div>

                <div class="card-icon">
                    <i class="bi bi-ticket-perforated-fill"></i>
                </div>

            </div>

        </div>

        <!-- Revenue -->
        <div class="col-xl-3 col-md-6">

            <div class="dashboard-card revenue-card">

                <div>

                    <p class="card-title">
                        Total Revenue
                    </p>

                    <h2>
                        @Model.TotalRevenue EGP
                    </h2>

                </div>

                <div class="card-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

            </div>

        </div>

    </div>

    <!-- Most Booked Movie -->
    <div class="dashboard-box mt-4">

        <h4>
            🔥 Most Booked Movie
        </h4>

        <div class="most-movie">

            @Model.MostBookedMovie

        </div>

    </div>

    <!-- Chart -->
    <div class="dashboard-box mt-4">

        <h4>
            📊 Bookings Per Movie
        </h4>

        <canvas id="moviesChart"></canvas>

    </div>

</div>

<script>

    const ctx = document.getElementById('moviesChart');

    new Chart(ctx, {

    type: 'bar',

    data: {

    labels: @Html.Raw(Json.Serialize(Model.MovieNames)),

    datasets: [{

    label: 'Bookings',

    data: @Html.Raw(Json.Serialize(Model.BookingCounts)),

    borderWidth: 2

    }]
    },

    options: {

    responsive: true,

    plugins: {

    legend: {

    labels: {
    color: 'white'
    }

    }

    },

    scales: {

    x: {

    ticks: {
    color: 'white'
    },

    grid: {
    color: '#374151'
    }

    },

    y: {

    ticks: {
    color: 'white'
    },

    grid: {
    color: '#374151'
    }

    }

    }

    }

    });

</script>
<style>
    .dashboard-title {
    color: #0f172a;
    font-weight: 800;
    font-size: 34px;
    text-align: center;
    }

    .dashboard-subtitle {
    color: #64748b;
    font-size: 14px;
    text-align: center;
    }
</style>
