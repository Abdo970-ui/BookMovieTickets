@using BookMovieTickets.Models
@model List<Movie>
@{
    Layout = "~/Areas/Admin/Views/_AdminLayout.cshtml";
}

<h2>Movies</h2>

<a asp-action="Create" class="btn btn-success">Add Movie</a>
<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Description</th>
        <th>MainImg</th>
        <th>Ticket Price</th>
        <th>Avilable</th>
        <th>DateTime</th>
        <th>Actors</th>
        <th>SubImages</th>
   
    </tr>

    @foreach (var item in Model)
    {
     
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Description</td>

            <td>
                <img src="~/images/@item.MainImg" width="80" />
            </td>

            <td>@item.Price</td>
            <td>@item.Status</td>
            <td>@item.DateTime</td>

            <td>
                @string.Join(", ", item.Actors.Select(a => a.Name))
            </td>

            <td>
                @foreach (var img in item.SubImages)
                {
                    <img src="~/images/@img.ImageUrl" width="50" />
                }
            </td>
        </tr>
        
    }
</table>