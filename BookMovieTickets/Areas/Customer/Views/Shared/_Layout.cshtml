<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Customer CSS -->
    <link rel="stylesheet" href="~/css/customer/customer.css" />

</head>

<body>

    <!-- 🔥 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
        <a class="navbar-brand text-danger fw-bold" href="#">🎬 MovieApp</a>

        <div class="ms-auto">
            <a class="btn btn-outline-light btn-sm me-2">Login</a>
            <a class="btn btn-danger btn-sm">Register</a>
        </div>
    </nav>

    <!-- 🔥 CONTENT -->
    <div>
        @RenderBody()
    </div>

    <!-- 🔥 FOOTER -->
    @* <footer class="text-center text-white mt-5 p-3 bg-dark">
        © 2026 Movie App
    </footer> *@

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>