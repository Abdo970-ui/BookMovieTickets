@using BookMovieTickets.Models
@model ShowTime

@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: #0b0f19;
    }

    .booking-container {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .booking-card {
        background: #111827;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 0 25px rgba(0,0,0,0.5);
        width: 100%;
        max-width: 900px;
    }

    .movie-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .booking-content {
        padding: 35px;
        color: white;
    }

    .movie-title {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .info-box {
        background: #1f2937;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 15px;
    }

    .info-label {
        color: #9ca3af;
        font-size: 14px;
    }

    .info-value {
        font-size: 20px;
        font-weight: bold;
    }

    .form-control {
        background: #1f2937;
        border: none;
        color: white;
        height: 50px;
    }

        .form-control:focus {
            background: #1f2937;
            color: white;
            box-shadow: 0 0 10px rgba(239,68,68,0.5);
        }

    .btn-book {
        background: #dc2626;
        border: none;
        height: 50px;
        font-size: 18px;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-book:hover {
            background: #ef4444;
            transform: scale(1.02);
        }

    .btn-back {
        margin-top: 10px;
        background: #374151;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 10px;
        width: 100%;
        transition: 0.3s;
        text-decoration: none;
        display: block;
        text-align: center;
    }

        .btn-back:hover {
            background: #4b5563;
        }
</style>

<div class="container booking-container">

    <div class="booking-card">

        <div class="row g-0">

            <!-- Movie Image -->
            <div class="col-md-5">
                <img src="@Url.Content("~/images/" + Model.Movie.MainImg)" class="movie-image" />
            </div>

            <!-- Booking Info -->
            <div class="col-md-7">
                <div class="booking-content">

                    <h2 class="movie-title">🎬 @Model.Movie?.Name</h2>

                    <div class="info-box">
                        <div class="info-label">Show Time</div>
                        <div class="info-value">⏰ @Model.StartTime</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Available Seats</div>
                        <div class="info-value text-success">
                            🎟 @Model.AvailableSeats Seats
                        </div>
                    </div>

                    @if (Model.AvailableSeats > 0)
                    {
                        <form method="post" action="/Customer/Home/ConfirmBooking">
                            <input type="hidden" name="showTimeId" value="@Model.Id" />

                            <label class="mb-2 fw-bold">Number Of Tickets</label>
                            <input type="number"
                                   name="tickets"
                                   class="form-control mb-4"
                                   min="1"
                                   max="@Model.AvailableSeats"
                                   required />

                            <button type="submit" class="btn btn-book w-100">
                                🎟 Confirm Booking
                            </button>
                        </form>
                    }
                    else
                    {
                        <script>
                                                toastr.error("🚫 Sold Out! No seats available.");
                        </script>
                    }

                    <a href="/Customer/Home/Index" class="btn-back">← Back to Movies</a>

                </div>
            </div>

        </div>

    </div>

</div>