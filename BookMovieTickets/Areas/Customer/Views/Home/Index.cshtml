@model BookMovieTickets.ViewModel.FilterMovieVM

@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
}

<style>

    .filter-box {
        background: #111;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .form-control, .form-select {
        background: #222;
        border: none;
        color: white;
    }

        .form-control::placeholder {
            color: #aaa;
        }

    .btn-filter {
        background: #4dabf7;
        border: none;
        color: white;
    }

    .movies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    .movie-card {
        background: #111;
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
        cursor: pointer;
        height: 100%;
    }

        .movie-card:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(77, 171, 247, 0.6);
        }

    .movie-img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        background: #000;
    }

    .movie-title {
        color: #4dabf7;
        padding: 15px 10px;
        font-weight: bold;
    }

    /* الستايل الخاص بعرض التاريخ تحت العنوان */
    .movie-date-badge {
        font-size: 13px;
        color: #aaa;
        display: block;
        margin-top: 6px;
        font-weight: normal;
    }

    .page-link {
        cursor: pointer !important;
        background: #111;
        border: 1px solid #333;
        color: white;
    }

    .page-item.active .page-link {
        background: #4dabf7;
        border-color: #4dabf7;
        color: black;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.6);
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: 0.3s;
        font-weight: bold;
        font-size: 18px;
    }

    .movie-card:hover .overlay {
        opacity: 1;
    }

</style>

<div class="container-fluid p-4">

    <h3 class="text-white mb-4">🎬 Movies</h3>

    <form method="get" class="filter-box row g-3">

        <div class="col-md-4">
            <input type="text"
                   name="MovieName"
                   value="@Model.MovieName"
                   class="form-control"
                   placeholder="Search movie..." />
        </div>

        <div class="col-md-3">
            <select name="CinemaId" class="form-select">
                <option value="">All Cinemas</option>

                @foreach (var cinema in ViewBag.Cinemas)
                {
                    <option value="@cinema.Id"
                            selected="@(Model.CinemaId == cinema.Id)">
                        @cinema.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <input type="date"
                   name="Date"
                   value="@(Model.Date?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-filter w-100">
                Filter
            </button>
        </div>

    </form>

    <div class="movies-grid">

        @foreach (var movie in Model.Movies)
        {
            // فحص ما إذا كان وقت الفيلم قد انتهى مقارنة بالوقت الحالي
            bool isEnded = movie.DateTime < DateTime.Now;

            <a href="/Customer/Home/Details/@movie.Id"
                   class="text-decoration-none text-white d-block">

                <div class="movie-card position-relative" style="@(isEnded ? "opacity: 0.55;" : "")">

                    <img src="@Url.Content("~/images/" + movie.MainImg)"
                         class="movie-img" />

                    @if (isEnded)
                    {
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2 p-2 fw-bold" style="z-index: 2;">
                            Ended / منتهي
                        </span>
                    }

                    <div class="overlay">
                        View Details
                    </div>

                    <div class="movie-title text-center">
                        @movie.Name

                        <span class="movie-date-badge">
                            📅 @movie.DateTime.ToString("dd MMM yyyy - hh:mm tt")
                        </span>
                    </div>

                </div>

            </a>
        }

    </div>

    @if (Model.TotalPages > 1)
    {
        // تجميع معاملات التصفية للحفاظ عليها أثناء التنقل بين الصفحات ومنع تصفير الفلتر
        var queryParams = $"&MovieName={Context.Request.Query["MovieName"]}&CinemaId={Context.Request.Query["CinemaId"]}&Date={Context.Request.Query["Date"]}&CategoryId={Context.Request.Query["CategoryId"]}";

        <nav class="mt-5">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Customer/Home/Index?Page=@(Model.Page - 1)@queryParams">
                        Previous
                    </a>
                </li>

                @{
                    int startPage = Math.Max(1, Model.Page - 2);
                    int endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="/Customer/Home/Index?Page=1@queryParams">
                            1
                        </a>
                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="/Customer/Home/Index?Page=@i@queryParams">
                            @i
                        </a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">
                        <a class="page-link" href="/Customer/Home/Index?Page=@Model.TotalPages@queryParams">
                            @Model.TotalPages
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="/Customer/Home/Index?Page=@(Model.Page + 1)@queryParams">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }