@model BookMovieTickets.ViewModel.FilterMovieVM

@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
}

<style>

    .filter-box {
        background: #111;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .form-control, .form-select {
        background: #222;
        border: none;
        color: white;
    }

        .form-control::placeholder {
            color: #aaa;
        }

    .btn-filter {
        background: #4dabf7;
        border: none;
        color: white;
    }

    .movies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    .movie-card {
        background: #111;
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
    }

        .movie-card:hover {
            transform: scale(1.03);
        }

    .movie-img {
        width: 100%;
        height: 300px;
        object-fit: contain;
        background: #000;
    }

    .movie-title {
        color: #4dabf7;
        padding: 10px;
        font-weight: bold;
    }

    .page-link {
        cursor: pointer !important;
        background: #111;
        border: 1px solid #333;
        color: white;
    }

    .page-item.active .page-link {
        background: #4dabf7;
        border-color: #4dabf7;
        color: black;
    }

</style>

<div class="container-fluid p-4">

    <h3 class="text-white mb-4">🎬 Movies</h3>

    <!-- 🔍 FILTER -->
    <form method="get" class="filter-box row g-3">

        <!-- Search -->
        <div class="col-md-4">
            <input type="text"
                   name="MovieName"
                   value="@Model.MovieName"
                   class="form-control"
                   placeholder="Search movie..." />
        </div>

        <!-- Cinema -->
        <div class="col-md-3">
            <select name="CinemaId" class="form-select">
                <option value="">All Cinemas</option>

                @foreach (var cinema in ViewBag.Cinemas)
                {
                    <option value="@cinema.Id"
                            selected="@(Model.CinemaId == cinema.Id)">
                        @cinema.Name
                    </option>
                }
            </select>
        </div>

        <!-- Date -->
        <div class="col-md-3">
            <input type="date"
                   name="Date"
                   value="@(Model.Date?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>

        <!-- Button -->
        <div class="col-md-2">
            <button type="submit" class="btn btn-filter w-100">
                Filter
            </button>
        </div>

    </form>

    <!-- 🎬 MOVIES -->
    <div class="movies-grid">

        @foreach (var movie in Model.Movies)
        {
            <div class="movie-card">

                <img src="@Url.Content("~/images/" + movie.MainImg)"
                     class="movie-img" />

                <div class="movie-title">
                    @movie.Name
                </div>

            </div>
        }

    </div>

    <!-- 📄 PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">

                <!-- Previous -->
                @if (Model.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="/Customer/Home/Index?Page=@(Model.Page - 1)&MovieName=@Context.Request.Query["MovieName"]&CinemaId=@Context.Request.Query["CinemaId"]&Date=@Context.Request.Query["Date"]&CategoryId=@Context.Request.Query["CategoryId"]">
                            Previous
                        </a>
                    </li>
                }

                <!-- Pages -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           href="/Customer/Home/Index?Page=@i&MovieName=@Context.Request.Query["MovieName"]&CinemaId=@Context.Request.Query["CinemaId"]&Date=@Context.Request.Query["Date"]&CategoryId=@Context.Request.Query["CategoryId"]">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                @if (Model.Page < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="/Customer/Home/Index?Page=@(Model.Page + 1)&MovieName=@Context.Request.Query["MovieName"]&CinemaId=@Context.Request.Query["CinemaId"]&Date=@Context.Request.Query["Date"]&CategoryId=@Context.Request.Query["CategoryId"]">
                            Next
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>