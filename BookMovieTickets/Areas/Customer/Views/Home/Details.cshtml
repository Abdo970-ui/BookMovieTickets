@using BookMovieTickets.Models
@model BookMovieTickets.Models.Movie

@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <div class="row">

        <!-- Image -->
        <div class="col-md-4">
            <img src="@Url.Content("~/images/" + Model.MainImg)"
                 class="img-fluid rounded shadow" />
        </div>

        <!-- Details -->
        <div class="col-md-8">

            <h2 class="text-white">@Model.Name</h2>

            <p class="text-info">
                @Model.Description
            </p>

            <p>
                <span class="badge bg-info">
                    @Model.Category?.Name
                </span>
            </p>

            <p class="text-warning">
                🎬 Cinema: @Model.Cinema?.Name
            </p>

            <p class="text-success">
                💰 Price: @Model.Price EGP
            </p>

            <hr class="bg-light" />

            <!-- Book Button -->
            @foreach (var item in ViewBag.ShowTimes as IEnumerable<ShowTime>)
            {
                <div class="card p-3 mb-2">

                    <p>⏰ @item.StartTime</p>
                    <p>Seats: @item.AvailableSeats</p>

                    <a href="/Customer/Home/Book?showTimeId=@item.Id"
                           class="btn btn-danger">
                        🎟 Book Now
                    </a>

                </div>
            }

        </div>

    </div>

</div>
