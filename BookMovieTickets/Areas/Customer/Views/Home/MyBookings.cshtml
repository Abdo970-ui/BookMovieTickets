@model IEnumerable<BookMovieTickets.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <h2 class="text-center mb-4 text-light">🎟 My Bookings</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            No bookings found.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var booking in Model)
            {
                <div class="col-md-6 mb-4" id="booking-card-@booking.Id">

                    <div class="card shadow-lg border-0 h-100 bg-dark text-light">

                        <div class="card-body">

                            <h4 class="card-title text-warning">
                                @booking.ShowTime.Movie.Name
                            </h4>

                            <hr />

                            <p>
                                <strong>📅 Show Time:</strong>
                                @booking.ShowTime.StartTime.ToString("dddd, dd MMM yyyy - hh:mm tt")
                            </p>

                            <p>
                                <strong>🎫 Tickets:</strong>
                                @booking.Tickets
                            </p>

                            <p>
                                <strong>💰 Total Price:</strong>
                                <span id="price-@booking.Id" class="fw-bold text-white">@booking.TotalPrice</span> EGP
                            </p>

                            <p>
                                <strong>💺 Available Seats:</strong>
                                @booking.ShowTime.AvailableSeats
                            </p>

                            <div class="promo-section bg-secondary bg-opacity-10 p-2 rounded mb-3">
                                <label class="form-label font-monospace small text-warning">Have a promo code?</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="promo-input-@booking.Id" class="form-control bg-dark text-white border-secondary" placeholder="Enter Code">
                                    <button class="btn btn-info btn-apply-promo" type="button" data-booking-id="@booking.Id" data-showtime-id="@booking.ShowTimeId">Apply</button>
                                </div>
                                <div id="promo-msg-@booking.Id" class="small mt-1 fw-bold"></div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap mt-3">

                                <a href="/Customer/Home/Pay?bookingId=@booking.Id"
                                       class="btn btn-primary">
                                    💳 Pay Now
                                </a>

                                <a href="/Customer/Home/IncrementTickets?bookingId=@booking.Id"
                                       class="btn btn-success">
                                    + Add Ticket
                                </a>

                                <a href="/Customer/Home/DecrementTickets?bookingId=@booking.Id"
                                       class="btn btn-warning">
                                    - Remove Ticket
                                </a>

                                <button type="button"
                                        class="btn btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@booking.Id">
                                    Delete
                                </button>

                                <div class="modal fade" id="deleteModal-@booking.Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-dark text-light border-secondary">

                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title">⚠️ Confirm Delete</h5>
                                                <button type="button"
                                                        class="btn-close btn-close-white"
                                                        data-bs-dismiss="modal">
                                                </button>
                                            </div>

                                            <div class="modal-body">
                                                Are you sure you want to delete this booking?
                                            </div>

                                            <div class="modal-footer border-secondary">
                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <a href="/Customer/Home/DeleteBooking?bookingId=@booking.Id"
                                                       class="btn btn-danger">
                                                    Yes, Delete
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        $(".btn-apply-promo").click(function () {
        // التقاط البيانات الخاصة بالكارت الذى تم الضغط عليه
        var bookingId = $(this).data("booking-id");
        var showTimeId = $(this).data("showtime-id");
        var promoCode = $("#promo-input-" + bookingId).val();
        var currentPrice = parseFloat($("#price-" + bookingId).text());

        var msgDiv = $("#promo-msg-" + bookingId);

        if (promoCode.trim() === "") {
        msgDiv.removeClass("text-success").addClass("text-danger").text("Please enter a code first!");
        return;
        }

        // إرسال الطلب للميثود الخلفية بالـ AJAX
        $.ajax({
        url: '/Customer/Home/CheckPromoCode',
        type: 'POST',
        data: {
        code: promoCode,
        currentShowTimeId: showTimeId,
        currentPrice: currentPrice
        },
        success: function (response) {
        if (response.success) {
        // نجاح الخصم: تلوين الرسالة بالأخضر وتحديث السعر الإجمالي للكارت
        msgDiv.removeClass("text-danger").addClass("text-success").text(response.message);
        $("#price-" + bookingId).text(response.newPrice.toFixed(2));
                            
        // إغلاق عناصر الإدخال بعد التطبيق بنجاح لمنع اللعب فيه مرة أخرى
        $("#promo-input-" + bookingId).prop("disabled", true);
        $("button[data-booking-id='" + bookingId + "']").prop("disabled", true);
        } else {
        // فشل الخصم: عرض رسالة الخطأ بالأحمر
        msgDiv.removeClass("text-success").addClass("text-danger").text(response.message);
        }
        },
        error: function () {
        msgDiv.removeClass("text-success").addClass("text-danger").text("Something went wrong. Please try again.");
        }
        });
        });
        });
    </script>
}